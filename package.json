{
  "name": "@alphazerolan/dsh-plugin-diy-journal",
  "version": "1.1.1",
  "description": "DIY Journal skin and local photo/layout editor in one DeepSeek Harness bundle",
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:python": "python tests/test_install.py",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Alphazerolan/diy-journal-settings.git"
  },
  "files": [
    "index.mjs",
    "client.js",
    "runtime.mjs",
    "cordis.patch.yml",
    "skin",
    "engine",
    "install.py",
    "README.md",
    "README.zh.md",
    "NOTICE",
    "LICENSE"
  ],
  "license": "SEE LICENSE IN NOTICE",
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  }
}
